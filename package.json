{
  "name": "r2-fastlink",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter r2fl build",
    "build:binary": "sh scripts/build-binary.sh",
