{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "push": true,
    "pushArgs": ["--follow-tags"]
  },
  "github": { "release": false },
  "npm": { "publish": false },
  "hooks": {
    "before:init": ["bash scripts/check-changelog.sh", "pnpm run verify"],
    "before:bump": ["node scripts/release.mjs check-version ${version}"],
    "after:bump": ["node scripts/release.mjs sync-version ${version}"]
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true
    }
  }
}
